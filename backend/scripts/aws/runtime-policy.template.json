{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "FeaturewiseBucketMetadata",
      "Effect": "Allow",
      "Action": ["s3:GetBucketLocation", "s3:ListBucketVersions"],
      "Resource": "arn:aws:s3:::__BUCKET__",
      "Condition": {
        "StringLike": { "s3:prefix": ["dev/staging/*", "dev/organizations/*"] }
      }
    },
    {
      "Sid": "FeaturewiseContextObjects",
      "Effect": "Allow",
      "Action": [
        "s3:PutObject",
        "s3:GetObject",
        "s3:GetObjectVersion",
        "s3:DeleteObject",
        "s3:DeleteObjectVersion"
      ],
      "Resource": [
        "arn:aws:s3:::__BUCKET__/dev/staging/*",
        "arn:aws:s3:::__BUCKET__/dev/organizations/*"
      ]
    }
  ]
}
