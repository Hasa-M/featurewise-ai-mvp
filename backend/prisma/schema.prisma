generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum FeatureOrigin {
  brand_new
  mapped_existing
}

enum AssetType {
  image
  file
}

enum SpecRunKind {
  generation
  consolidation
}

enum SpecRunStatus {
  queued
  preparing_context
  calling_llm
  validating_output
  repairing_output
  checking_quality
  persisting
  completed
  failed
}

enum LlmCallPurpose {
  generation
  schema_repair
}

enum LlmCallOutcome {
  success
  error
}

model Organization {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @map("organization_id") @db.Uuid
  publicNumber Int       @unique(map: "organization_public_number_key") @default(dbgenerated("nextval('organization_public_number_seq'::regclass)")) @map("public_number")
  name         String
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  projects     Project[]
  users        User[]

  @@map("organization")
}

model User {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @map("user_id") @db.Uuid
  publicNumber   Int          @unique(map: "user_public_number_key") @default(dbgenerated("nextval('user_public_number_seq'::regclass)")) @map("public_number")
  organizationId String       @unique @map("organization_id") @db.Uuid
  username       String       @unique
  passwordHash   String       @map("password_hash")
  isActive       Boolean      @default(true) @map("is_active")
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  features       Feature[]
  featureUpdates FeatureUpdate[]
  specRuns       SpecRun[]

  @@map("user")
}

model Project {
  id             String                 @id @default(dbgenerated("gen_random_uuid()")) @map("project_id") @db.Uuid
  publicNumber   Int                    @unique(map: "project_public_number_key") @default(dbgenerated("nextval('project_public_number_seq'::regclass)")) @map("public_number")
  organizationId String                 @unique @map("organization_id") @db.Uuid
  name           String
  createdAt      DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime               @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization   Organization           @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  features       Feature[]
  summary        ProjectContextSummary?

  @@map("project")
}

model ProjectContextSummary {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @map("summary_id") @db.Uuid
  publicNumber Int      @unique(map: "project_context_summary_public_number_key") @default(dbgenerated("nextval('project_context_summary_public_number_seq'::regclass)")) @map("public_number")
  projectId    String   @unique @map("project_id") @db.Uuid
  content      String   @default("")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("project_context_summary")
}

model Feature {
  id                      String             @id @default(dbgenerated("gen_random_uuid()")) @map("feature_id") @db.Uuid
  publicNumber            Int              @unique(map: "feature_public_number_key") @default(dbgenerated("nextval('feature_public_number_seq'::regclass)")) @map("public_number")
  projectId               String             @map("project_id") @db.Uuid
  title                   String
  brief                   String?
  origin                  FeatureOrigin
  includeInProjectContext Boolean            @default(false) @map("include_in_project_context")
  createdById             String             @map("created_by") @db.Uuid
  createdAt               DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt               DateTime?          @map("deleted_at") @db.Timestamptz(6)
  contextArtifact         ContextArtifact?
  createdBy               User               @relation(fields: [createdById], references: [id], onDelete: Restrict)
  generatedSpecs          GeneratedSpec[]
  project                 Project            @relation(fields: [projectId], references: [id], onDelete: Restrict)
  specRuns                SpecRun[]
  updates                 FeatureUpdate[]

  @@index([projectId])
  @@index([createdById])
  @@map("feature")
}

model FeatureUpdate {
  id              String             @id @default(dbgenerated("gen_random_uuid()")) @map("feature_update_id") @db.Uuid
  publicNumber    Int                @unique(map: "feature_update_public_number_key") @default(dbgenerated("nextval('feature_update_public_number_seq'::regclass)")) @map("public_number")
  featureId       String             @map("feature_id") @db.Uuid
  title           String
  brief           String?
  createdById     String             @map("created_by") @db.Uuid
  createdAt       DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt       DateTime?          @map("deleted_at") @db.Timestamptz(6)
  contextArtifact ContextArtifact?
  createdBy       User               @relation(fields: [createdById], references: [id], onDelete: Restrict)
  feature         Feature            @relation(fields: [featureId], references: [id], onDelete: Restrict)
  generatedSpecs  GeneratedSpec[]
  specRuns        SpecRun[]

  @@index([featureId])
  @@index([createdById])
  @@map("feature_update")
}

model ContextArtifact {
  id              String          @id @default(dbgenerated("gen_random_uuid()")) @map("context_artifact_id") @db.Uuid
  publicNumber    Int             @unique(map: "context_artifact_public_number_key") @default(dbgenerated("nextval('context_artifact_public_number_seq'::regclass)")) @map("public_number")
  featureId       String?         @unique @map("feature_id") @db.Uuid
  featureUpdateId String?         @unique @map("feature_update_id") @db.Uuid
  content         String          @default("")
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)
  feature         Feature?        @relation(fields: [featureId], references: [id], onDelete: Cascade)
  featureUpdate   FeatureUpdate?  @relation(fields: [featureUpdateId], references: [id], onDelete: Cascade)
  storageObjects  StorageObject[]

  @@map("context_artifact")
}

model StorageObject {
  id                String          @id @default(dbgenerated("gen_random_uuid()")) @map("storage_object_id") @db.Uuid
  publicNumber      Int             @unique(map: "storage_object_public_number_key") @default(dbgenerated("nextval('storage_object_public_number_seq'::regclass)")) @map("public_number")
  contextArtifactId String          @map("context_artifact_id") @db.Uuid
  s3Key             String          @unique @map("s3_key")
  assetType         AssetType       @map("asset_type")
  mimeType          String          @map("mime_type")
  sizeBytes         BigInt          @map("size_bytes")
  originalFilename  String          @map("original_filename")
  extractedText     String?         @map("extracted_text")
  createdAt         DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  contextArtifact   ContextArtifact @relation(fields: [contextArtifactId], references: [id], onDelete: Restrict)

  @@index([contextArtifactId])
  @@map("storage_object")
}

model SpecRun {
  id              String          @id @default(dbgenerated("gen_random_uuid()")) @map("spec_run_id") @db.Uuid
  publicNumber    Int             @unique(map: "spec_run_public_number_key") @default(dbgenerated("nextval('spec_run_public_number_seq'::regclass)")) @map("public_number")
  featureId       String          @map("feature_id") @db.Uuid
  featureUpdateId String?         @map("feature_update_id") @db.Uuid
  runKind         SpecRunKind     @map("run_kind")
  status          SpecRunStatus
  promptVersion   String          @map("prompt_version")
  schemaVersion   String          @map("schema_version")
  genSettings     Json            @default("{}") @map("gen_settings")
  contextSnapshot Json            @map("context_snapshot")
  errorMessage    String?         @map("error_message")
  createdById     String          @map("created_by") @db.Uuid
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  startedAt       DateTime?       @map("started_at") @db.Timestamptz(6)
  finishedAt      DateTime?       @map("finished_at") @db.Timestamptz(6)
  updatedAt       DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy       User            @relation(fields: [createdById], references: [id], onDelete: Restrict)
  feature         Feature         @relation(fields: [featureId], references: [id], onDelete: Restrict)
  featureUpdate   FeatureUpdate?  @relation(fields: [featureUpdateId], references: [id], onDelete: Restrict)
  generatedSpec   GeneratedSpec?
  llmCallLogs     LlmCallLog[]

  @@index([featureId])
  @@index([featureUpdateId])
  @@index([createdById])
  @@map("spec_run")
}

model GeneratedSpec {
  id                   String          @id @default(dbgenerated("gen_random_uuid()")) @map("generated_spec_id") @db.Uuid
  publicNumber         Int             @unique(map: "generated_spec_public_number_key") @default(dbgenerated("nextval('generated_spec_public_number_seq'::regclass)")) @map("public_number")
  featureId            String          @map("feature_id") @db.Uuid
  featureUpdateId      String?         @map("feature_update_id") @db.Uuid
  specRunId            String?         @unique @map("spec_run_id") @db.Uuid
  parentSpecId         String?         @map("parent_spec_id") @db.Uuid
  version              Int             @default(0)
  content              Json
  schemaVersion        String          @map("schema_version")
  valid                Boolean         @default(false)
  warnings             Json            @default("[]")
  incorporatedUpdates  Json            @default("[]") @map("incorporated_updates")
  createdAt            DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)
  derivedSpecs         GeneratedSpec[] @relation("GeneratedSpecDerivation")
  feature              Feature         @relation(fields: [featureId], references: [id], onDelete: Restrict)
  featureUpdate        FeatureUpdate?  @relation(fields: [featureUpdateId], references: [id], onDelete: Restrict)
  parentSpec           GeneratedSpec?  @relation("GeneratedSpecDerivation", fields: [parentSpecId], references: [id], onDelete: Restrict)
  specRun              SpecRun?        @relation(fields: [specRunId], references: [id], onDelete: Restrict)

  @@index([featureId])
  @@index([featureUpdateId])
  @@index([parentSpecId])
  @@map("generated_spec")
}

model LlmCallLog {
  id             String         @id @default(dbgenerated("gen_random_uuid()")) @map("llm_call_id") @db.Uuid
  publicNumber   Int            @unique(map: "llm_call_log_public_number_key") @default(dbgenerated("nextval('llm_call_log_public_number_seq'::regclass)")) @map("public_number")
  specRunId      String         @map("spec_run_id") @db.Uuid
  purpose        LlmCallPurpose
  attempt        Int
  provider       String
  model          String
  promptVersion  String         @map("prompt_version")
  schemaVersion  String         @map("schema_version")
  inputTokens    Int            @map("input_tokens")
  outputTokens   Int            @map("output_tokens")
  latencyMs      Int            @map("latency_ms")
  outcome        LlmCallOutcome
  errorMessage   String?        @map("error_message")
  rawResponse    Json?          @map("raw_response")
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  specRun        SpecRun        @relation(fields: [specRunId], references: [id], onDelete: Restrict)

  @@index([specRunId])
  @@map("llm_call_log")
}
