# Local development only. Copy to .env and choose your own password.
DATABASE_HOST=localhost
DATABASE_PORT=5433
DATABASE_USER=featurewise_user
DATABASE_PASSWORD=change_me_featurewise_local
DATABASE_NAME=featurewise_dev
DATABASE_SSL=false
AUTH_TOKEN_SECRET=change_me_featurewise_local_auth_secret
AUTH_ACCESS_TOKEN_TTL_SECONDS=43200
SEED_PASSWORD=choose_a_local_development_password
AWS_PROFILE=featurewise_account_name
AWS_REGION=eu-south-1
S3_BUCKET=featurewise-dev-your-aws-account-id-eu-south-1
S3_KEY_PREFIX=dev
S3_UPLOAD_TTL_SECONDS=900
S3_DOWNLOAD_TTL_SECONDS=300
STORAGE_PENDING_TTL_HOURS=24
STORAGE_FAILED_RETENTION_DAYS=7
STORAGE_PROCESSING_TIMEOUT_SECONDS=600
STORAGE_SWEEP_INTERVAL_SECONDS=3600
LIBREOFFICE_PATH=path/to/LibreOffice/executable
